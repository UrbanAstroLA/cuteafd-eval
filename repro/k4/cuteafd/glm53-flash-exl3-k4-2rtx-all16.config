# GLM-5.3-Flash brandonmusic tr3-4bpw ("K4", a5fee929) on 2x RTX PRO 6000, no Sparks, engine defaults (decision 2026-10-27).
# Derived from <cuteafd>/local/glm53-flash-exl3-k3.25-core-fp8-2rtx.config.
# Differences: MODEL_ID/MODEL_REVISION; VISION=off (the K4 template has no image markers, so
# VISION=auto would serve text only anyway); FP8_SCALES left at the engine default (pow2) to
# match the C0 arm -- set FP8_SCALES=amax to approximate the official FP8 codes instead.
#
#   ./run.sh --config local/glm53-flash-exl3-k4-2rtx.config [--dry-run]

MODEL_ID=brandonmusic/GLM-5.3-Flash-tr3-4bpw
MODEL_REVISION=a5fee929cf4888b1824323e33e8a19b60129e025
GLM5_FLASH_FP8_MODEL_ID=off
SPECULATOR=dflash2
SPECULATOR_MODEL_ID=incoai/GLM-5.3-Flash-DFlash2
SPECULATOR_MODEL_REVISION=bf582e4eacc1810f76656d1811693ff6c6737d2a
POOL_TOKENS=auto
# At pure defaults the planner refuses K4 on 2x RTX (pool 260,608 < the 1,048,576-token context floor). A 256K window
# is the one local setting this config adds (declared difference, 2026-10-27); the planner then gives a 605,696-token pool.
MAX_CONTEXT_TOKENS=139264
VISION=off

EXPERT_BACKEND=local
SPARK_COUNT=0
RTX_GPUS=2
COORDINATOR_GPU=0

ADDR=127.0.0.1:8001
MAX_OUTPUT_TOKENS=393216
USAGE=off

COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v3.0.1@sha256:392db7c0bdd39ec5aacda800f9a3ada70342721a2357ad1ec09ad0ef5981459a

# F1-K4b follow-up (f1k4/FOLLOWUPS-K4b.md): FP8 switch arm "all16"; the only changes from glm53-flash-exl3-k4-2rtx.config follow.
FP8_SCALES=best
GLM5_FLASH_KDA_FP8=off
GLM5_FLASH_FP8_HEAD=off
GLM5_FLASH_FP8_PREFILL=off
# Memory rule (FOLLOWUPS-K4b.md): at 262,144 the planner refused this arm (pool 194,560 tokens short); context 139,264 here.
