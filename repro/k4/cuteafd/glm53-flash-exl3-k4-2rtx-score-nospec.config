# CuteAFD v3.0.1 scoring launch for the K4 three-engine comparison, Block Q (top-20).
# Install as <cuteafd>/local/glm53-flash-exl3-k4-2rtx-score.config (the chain refuses to run Stage 2
# for CuteAFD without it), then dry-run it (docker, no GPU) and compare with the serving plan:
#   cp <k4-run>/proposed/glm53-flash-exl3-k4-2rtx-score.config.PROPOSED \
#      <cuteafd>/local/glm53-flash-exl3-k4-2rtx-score.config
#   cd <cuteafd> && ./run.sh --config local/glm53-flash-exl3-k4-2rtx-score.config --dry-run
#
# Identical to local/glm53-flash-exl3-k4-2rtx.config (serving, as used in Stage 1) plus the three settings the
# probe path needs, as in the K3.25 *-score.config files:
#   ENABLE_BENCH=on          POST /v1/bench/probe and /v1/bench/status
#   API_KEY_FILE=...         required with the bench endpoint; then every /v1/* request needs the key. The chain
#                            creates the key with umask 077 under <secrets> before the launch and
#                            shreds it after the stop, on every exit path.
#   FULL_PREFILL_LOGITS=on   prefill-shaped scoring (score_path "prefill") is admitted at launch only
# No PROBE_DUMP_ROOT: the top-20 capture asks for no full-row dumps (no dump_rows in the probe spec).
# Everything else (FP8 load-time conversion with pow2 scales, DFlash2 drafter, pool auto, MAX_CONTEXT_TOKENS) is the
# serving launch's; the scoring requests themselves are cold and draft-free.

MODEL_ID=brandonmusic/GLM-5.3-Flash-tr3-4bpw
MODEL_REVISION=a5fee929cf4888b1824323e33e8a19b60129e025
GLM5_FLASH_FP8_MODEL_ID=off
SPECULATOR=dflash2
SPECULATOR_MODEL_ID=incoai/GLM-5.3-Flash-DFlash2
SPECULATOR_MODEL_REVISION=bf582e4eacc1810f76656d1811693ff6c6737d2a
POOL_TOKENS=auto
MAX_CONTEXT_TOKENS=262144
VISION=off

EXPERT_BACKEND=local
SPARK_COUNT=0
RTX_GPUS=2
COORDINATOR_GPU=0

ADDR=127.0.0.1:8001
MAX_OUTPUT_TOKENS=393216
USAGE=off

ENABLE_BENCH=on
API_KEY_FILE=<secrets>/bench-api-key
FULL_PREFILL_LOGITS=on
# Scoring launch only: the full prefill-logits buffer does not fit beside the desktop's 2.6 GB context on GPU 1
# (live launch 2026-10-27: "41 of 42 fit"). Probe requests never read the prefix cache, so turning it off frees
# memory without changing any scored value. The serving config keeps the default (20).
PREFIX_CACHE_ENTRIES=0

COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v3.0.1@sha256:392db7c0bdd39ec5aacda800f9a3ada70342721a2357ad1ec09ad0ef5981459a

# F1-K4b amendment B1 control arm "nospec": the K4 scoring config with only the drafter removed (FOLLOWUPS-K4b.md).
SPECULATOR=off
