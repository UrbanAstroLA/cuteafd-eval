{
 "rule": {
  "T_prompt_shape": "user message = nonce line + '\\n' + context_frame(context prefix, task). The context prefix is cut at a token boundary of the context document's own tokenization (character offset of the k-th token) and stripped of trailing whitespace, k searched so that the full templated prompt with the nonce line is exactly the target length (1,024 / 8,192 / 32,768 / 131,072); if no k gives an exact count, the character cut is moved character by character outward from the binary-search cut (within +-64 tokens), trying at each position the stripped cut and then the raw cut (trailing whitespace kept), and the nearest exact cut is taken (later cut first); any residual deviation is recorded per cell.",
  "T_contexts": "prose -> PG-19 book 4; code -> code document 3; reasoning -> PG-19 book 5; json -> code document 4. One fixed context per content type; prompts differ only in the task and in where the cut falls.",
  "T_lengths": "prose and code at 1K/8K/32K/128K; reasoning and json at 1K and 8K only (protocol).",
  "T_prose_items": "LongBench-Write items with length >= 1,000 words, excluding the 4 Block L prose items, sorted by file index; random.Random(261002).shuffle; first 4.",
  "T_code_items": "HumanEval+ task_ids sorted by number, random.Random(261003).shuffle, first 2 whose bare prompt fits 896 tokens; MBPP+ task_ids sorted, random.Random(261004).shuffle, first 2 that fit (MBPP prompt + test_list[0]). Prompt indices: HumanEval 0,1 then MBPP 2,3.",
  "math_items": "MATH-500 level-5 items sorted by unique_id, random.Random(261005).shuffle; walk the list keeping items whose reference solution's last \\boxed answer is_equiv() its `answer` (checkers/math_check.py) and whose bare prompt fits 896 tokens; first 4 -> Block T, next 4 -> Block L.",
  "json_items": "authored/json_task.json: Block T variants_T (n = 40); Block L themes with n from variants_L_rule.",
  "thinking": "on for reasoning (chat_template_kwargs.enable_thinking=true), off for prose, code, json.",
  "nonce": "see authored/wrappers.json nonce_rule; NONCE_GROUPS in prompts/nonce_groups.json."
 },
