{
 "about": "Authored JSON task for Blocks T and L (written 2026-10-26, before any run). One schema, one prompt template; variants differ in theme and N.",
 "record_schema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "sku", "name", "category", "price_cents", "in_stock", "tags", "dimensions_mm", "supplier"],
  "properties": {
   "id": {"type": "integer", "minimum": 1},
   "sku": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{5}$"},
   "name": {"type": "string", "minLength": 3, "maxLength": 60},
   "category": {"type": "string", "enum": ["tools", "storage", "lighting", "outdoor", "kitchen", "electrical", "garden", "safety"]},
   "price_cents": {"type": "integer", "minimum": 1, "maximum": 10000000},
   "in_stock": {"type": "boolean"},
   "tags": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,19}$"}},
   "dimensions_mm": {"type": "object", "additionalProperties": false, "required": ["length", "width", "height"],
                     "properties": {"length": {"type": "integer", "minimum": 1, "maximum": 100000},
                                    "width": {"type": "integer", "minimum": 1, "maximum": 100000},
                                    "height": {"type": "integer", "minimum": 1, "maximum": 100000}}},
   "supplier": {"type": "object", "additionalProperties": false, "required": ["name", "country"],
                "properties": {"name": {"type": "string", "minLength": 2, "maxLength": 60},
                               "country": {"type": "string", "pattern": "^[A-Z]{2}$"}}}
  }
 },
 "prompt_template": "Generate a product catalogue for {theme} as JSON.\n\nReturn exactly {n} records in one JSON array and nothing else: no explanation before or after it and no code fences. Every record must validate against this JSON Schema:\n\n{schema}\n\nFurther rules:\n- The id values are 1 to {n}, in order.\n- Every sku is unique.\n- Make the products varied and realistic for {theme}; do not repeat a name.\n- Write each record compactly on its own line.",
 "example_record": {"id": 1, "sku": "HWS-00417", "name": "Cordless Drill Driver 18V", "category": "tools", "price_cents": 8999, "in_stock": true, "tags": ["cordless", "drill", "battery"], "dimensions_mm": {"length": 210, "width": 80, "height": 250}, "supplier": {"name": "Brightline Tools Ltd", "country": "GB"}},
 "variants_T": [
  {"theme": "a neighbourhood hardware store", "n": 40},
  {"theme": "a camping and hiking outfitter", "n": 40},
  {"theme": "a restaurant kitchen supply shop", "n": 40},
  {"theme": "a garden centre", "n": 40}
 ],
 "variants_L_rule": "n chosen so that n x (tokens of example_record as one compact line + 2) is about 0.6 x 8,192, 0.6 x 32,768, 0.5 x 131,072 and 0.85 x 131,072 output tokens, rounded to a multiple of 10 (computed by build_prompts.py from the tokenizer; the resulting n is fixed in L/index.json and hashed).",
 "variants_L_themes": ["an industrial safety equipment distributor", "a home lighting showroom", "an electrical wholesaler", "a self-storage and moving supplies shop"],
 "variants_L_fractions": [[8192, 0.6], [32768, 0.6], [131072, 0.5], [131072, 0.85]]
}
