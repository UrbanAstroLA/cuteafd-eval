 "rules": {
  "tokenizer": "tokenizer.json of K3.25-v1 snapshot 0490d2f7 (both engines use this vocabulary); encode(text, add_special_tokens=False)",
  "text_normalization": "PG-19 books: bytes decoded as UTF-8, CRLF -> LF. vLLM sources: decoded as UTF-8 (files that fail are excluded), otherwise verbatim.",
  "prose_front_matter_skip": "drop the first 16384 characters, then everything up to and including the next blank line (first '\\n\\n' at or after that offset), then any further leading newlines; the document starts at the next character.",
  "pg19_book_roles": "books in pg19/SELECTION.json 'picked' order (seed 70901 there): 1st-3rd -> Q2 prose windows; 4th -> Block T prose context; 5th -> Block T reasoning context (8K).",
  "code_eligible_files": ".py files under vllm/ in image ea0430aa whose first 5 lines contain 'SPDX-License-Identifier: Apache-2.0' and whose size is >= 2048 bytes; sorted by relative path; shuffled with random.Random(261001).shuffle.",
  "code_documents": "documents are built by walking the shuffled list once, without reuse: each document appends files ('# ===== file: <relative path> =====\\n' + file text, newline-terminated, + '\\n'; each file keeps its own license/header lines) until its tokenization reaches the needed length. Documents 0-2 -> Q2 code windows (need 131,072 tokens); document 3 -> Block T code context (need 131,072); document 4 -> Block T JSON context (need 8,192). Code front-matter skip: none (0 characters).",
  "q2_windows": "tokens = first L ids of the whole document's tokenization (raw text, no chat template, no BOS), L in 32,768 / 65,536 / 131,072, so the shorter windows of one document are prefixes of the longer; rows = the last 4,096 row indices L-4,096 .. L-1, where row p is the position whose prediction of token p is scored (it has seen tokens 0..p-1).",
  "chat_template": "checkpoint chat_template.jinja (byte-identical to vLLM's glm53-zai-a5b45eb.jinja) renders one user message as TEMPLATE_PREFIX + content + TEMPLATE_SUFFIX; build verifies this with jinja2. The template has no thinking switch: CuteAFD renders thinking-off as an extra '</think>' (+1 token); vLLM renders the same text for on and off (its glm47 parser then streams the reasoning as content). Recorded prompt_tokens are for the template text including the nonce line.",
  "T_prompt_shape": "user message = nonce line + '\\n' + context_frame(context prefix, task). The context prefix is cut at a token boundary of the context document's own tokenization (character offset of the k-th token) and stripped of trailing whitespace, k searched so that the full templated prompt with the nonce line is exactly the target length (1,024 / 8,192 / 32,768 / 131,072); if no k gives an exact count, the character cut is moved character by character outward from the binary-search cut (within +-64 tokens), trying at each position the stripped cut and then the raw cut (trailing whitespace kept), and the nearest exact cut is taken (later cut first); any residual deviation is recorded per cell.",
  "T_contexts": "prose -> PG-19 book 4; code -> code document 3; reasoning -> PG-19 book 5; json -> code document 4. One fixed context per content type; prompts differ only in the task and in where the cut falls.",
  "T_lengths": "prose and code at 1K/8K/32K/128K; reasoning and json at 1K and 8K only (protocol).",
  "T_prose_items": "LongBench-Write items with length >= 1,000 words, excluding the 4 Block L prose items, sorted by file index; random.Random(261002).shuffle; first 4.",
  "T_code_items": "HumanEval+ task_ids sorted by number, random.Random(261003).shuffle, first 2 whose bare prompt fits 896 tokens; MBPP+ task_ids sorted, random.Random(261004).shuffle, first 2 that fit (MBPP prompt + test_list[0]). Prompt indices: HumanEval 0,1 then MBPP 2,3.",
  "math_items": "MATH-500 level-5 items sorted by unique_id, random.Random(261005).shuffle; walk the list keeping items whose reference solution's last \\boxed answer is_equiv() its `answer` (checkers/math_check.py) and whose bare prompt fits 896 tokens; first 4 -> Block T, next 4 -> Block L.",
  "json_items": "authored/json_task.json: Block T variants_T (n = 40); Block L themes with n from variants_L_rule.",
  "L_prose_items": "LongBench-Write items sorted by required length descending, ties by file index ascending; first 4.",
  "L_code_items": "the 4 authored projects in prompts/L/code (minicalc, kvstore, graphkit, csvreport), SPEC.md in the L_code wrapper; hidden tests in each tests/ directory.",
  "L_prompt_shape": "user message = nonce line + '\\n' + task (no context).",
  "thinking": "on for reasoning (chat_template_kwargs.enable_thinking=true), off for prose, code, json.",
  "nonce": "see authored/wrappers.json nonce_rule; NONCE_GROUPS in prompts/nonce_groups.json."
