# Local config: GLM-5.3-Flash EXL3 K3.25 Core-FP8 on 2x RTX PRO 6000, no Sparks.
#
# Follows tpurtell's 2-RTX v3 card (benchmarks/glm5_flash/2026-10-18-smoke-
# glm-5-3-flash-exl3-k3-25-v1-2rtx-glm53f-exl3-max): head split across both
# GPUs, routed experts on the coordinator GPUs, DFlash2 drafter.
# Differences from the card, all deliberate:
#   - Core-FP8 checkpoint: K3.25-v1's expert bytes unchanged (byte-checked
#     locally) with the official FP8 projections stitched in, so no separate
#     FP8 companion checkpoint (GLM5_FLASH_FP8_MODEL_ID=off).
#   - ADDR on 127.0.0.1: the coordinator uses host networking, which
#     DOCKER-USER does not filter. Port 8001 is the shared recipe endpoint.
#   - USAGE=off: no plain-text request/response logging.
#   - Image pinned by digest (v3.0.1).
#   - MAX_OUTPUT_TOKENS at the engine ceiling (393,216) instead of the
#     launcher's bare 4096 default, which silently clamps longer max_tokens.
#     Clients and eval harnesses set their own max_tokens per request.
#
#   cd <cuteafd>
#   ./run.sh --config local/glm53-flash-exl3-k3.25-core-fp8-2rtx.config --dry-run
#   ./run.sh --config local/glm53-flash-exl3-k3.25-core-fp8-2rtx.config --restart
#   ./stop.sh --config local/glm53-flash-exl3-k3.25-core-fp8-2rtx.config

MODEL_ID=wrldsuksgo2mars/GLM-5.3-Flash-EXL3-K3.25-Core-FP8
MODEL_REVISION=d31ebc921f1f098b4a56d37aaccb3cdef4096184
GLM5_FLASH_FP8_MODEL_ID=off
SPECULATOR=dflash2
SPECULATOR_MODEL_ID=incoai/GLM-5.3-Flash-DFlash2
SPECULATOR_MODEL_REVISION=bf582e4eacc1810f76656d1811693ff6c6737d2a
POOL_TOKENS=auto

EXPERT_BACKEND=local
SPARK_COUNT=0
RTX_GPUS=2
COORDINATOR_GPU=0

ADDR=127.0.0.1:8001
MAX_OUTPUT_TOKENS=393216
USAGE=off

# Block Q scoring launch (2026-10-26): bench endpoint (needs an API key), all-row prefill
# logits, probe dumps under the run folder. Everything else as the serving config.
ENABLE_BENCH=on
API_KEY_FILE=<secrets>/bench-api-key
FULL_PREFILL_LOGITS=on
PROBE_DUMP_ROOT=<run>/q/dumps

COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v3.0.1@sha256:392db7c0bdd39ec5aacda800f9a3ada70342721a2357ad1ec09ad0ef5981459a

# Follow-up F1 (FOLLOWUPS.md): FP8 ablation arm f1c
GLM5_FLASH_FP8_PREFILL=off
